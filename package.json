{
  "name": "material-you-wallpaper",
  "private": true,
  "version": "1.0.0",
  "description": "Minimalist Material You Wave Wallpaper Generator & Studio",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/unit/*.test.js",
    "test:browser": "playwright test",
    "test:cross-browser": "playwright test --config=playwright.cross.config.js",
    "test:firefox": "playwright test --config=playwright.cross.config.js --project=firefox",
    "check": "pnpm test && pnpm test:browser && pnpm test:production",
    "test:production": "pnpm build && node scripts/check-production.mjs"
  },
  "keywords": [
    "material-you",
    "wallpaper",
    "generator",
    "canvas",
    "svg",
    "hyprland"
  ],
  "author": "beilusm233",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^6.2.0"
  }
}
